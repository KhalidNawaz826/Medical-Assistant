# ============================================================
# MedQuAD Bilingual Medical Assistant - .gitignore
# ============================================================

# ----- Python Virtual Environment -----
# Never commit the local venv; recreate with: pip install -r requirements.txt
.venv/
venv/
env/
ENV/

# ----- Python Compiled / Cache -----
__pycache__/
*.py[cod]
*$py.class
*.pyo

# ----- Byte-compiled cache (Python 3) -----
*.pyc

# ----- Semantic Search Artifacts (future - not yet present) -----
# Pre-built embedding matrix; generated by embed_index.py
embeddings.npy
# Any other numpy binary artifacts
*.npy
*.npz

# ----- Raw Upstream Dataset Files -----
# Raw 11,200+ XML files from MedQuAD; ingested records are in records.jsonl
data/


# ----- HuggingFace Model Cache -----
# Models downloaded via sentence-transformers are cached here by default
.cache/
*.bin
*.safetensors
*.gguf
*.ggml

# ----- Manual Backup Files -----
# .bak files are pre-edit snapshots; Git makes these redundant once initialized
*.bak
*.bak2
*.bak3

# ----- Secrets and Credentials -----
.env
.env.*
*.key
*.pem
*.secret
secrets.json
credentials.json
config.local.*

# ----- OS and Editor Junk -----
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
.vscode/
*.code-workspace

# ----- Distribution / Build -----
dist/
build/
*.egg-info/
*.egg
